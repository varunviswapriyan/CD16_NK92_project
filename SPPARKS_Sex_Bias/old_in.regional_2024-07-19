# SPPARKS Sex bias model

seed		 8377

# narg != 24
app_style    rxn/diff/custom 600 600 4 2 1 1 1 1 1000 10.0 0.03 0.166 0.14 10 1 1 15 15 0 0.03 5 0 0.56 # 100 lattice width, 100 lattice height, 3 max pixel occupancy, 2 cancer occupancy, 1 Tp occupancy, 1 Tm occupancy, 1 Te occupancy, do carrying capacity? 0 for no 1 for yes, 14000 tcell carrying capacity, 54 ifng diffusion rate, 0.1 (1min) one ifng time step, 0.1 ifng production (s-1), 0.03 ifng uptake (s-1), 10000 ifng saturation threshold, 0 whether to use ifng limitation of cancer, 1 whether to use ifng augmentation of t cell cytotoxicity, 3000 max ifng conc to get minimum cancer prolif, 3000 max ifng conc to get max cytotoxicity, 1 do ifng periodic bc, 0.03 diffusion rate reduction of adhering T cells, ifng feedback threshold, 0 whether or not to update all sites at every event

dimension	 2
lattice		 sq/4n 1.0 # number of neighbors
boundary	 n n p

region		 box block 0 600 0 600 0 1 # 0 20 0 20 -1 1 # Size of Lattice x, y, z
create_box	 box
create_sites	 box

# Each discrete number is a separate voxel, bounds are inclusive. 0 0 0 0 refers to one voxel. What about z?

read_sites       sex_bias_initialization_files/d14_F_4_SPPARKS_init # single_cell_ifng_initializationSPPARKS_init # d7_M_1_SPPARKS_init

sector		no
solve_style     tree

add_species A # 0 Cancer cells
add_species	B # 1 Progenitor CD8+ T Cells
add_species	C # 2 Mature CD8+ T Cells
add_species	D # 3 Exhausted CD8+ T Cells
add_species	E # 4 AR+ Progenitor CD8+ T Cells
add_species	F # 5 AR+ Mature CD8+ T Cells
add_species	G # 6 AR+ Exhausted CD8+ T Cells
add_species	I # 7 Recruiting
add_species	J # 8 code output signal
add_species	K # 9 Dead cells
add_species	L # 10 Lattice edge
add_species M # 11 IFNG diffusable region
add_species	H # 0 IFNG/Cytokine record # needs to be last or SPPARKS confuses itself

add_rxn     0 local A nbr 0.0009652 local A nbr             # Cancer proliferation, rag2ko growth rate
add_rxn     1 local B nbr 0.00347 local B B nbr             # Tp proliferation (0.01 in ICS)
add_rxn     2 local C nbr 0.00347 local C C nbr             # Tm proliferation
add_rxn     3 local D nbr 0.00 local D D nbr                # Te proliferation
add_rxn     4 local E nbr 0.00347 local E E nbr             # AR+ Tp proliferation
add_rxn     5 local F nbr 0.00347 local F F nbr             # AR+ Tm proliferation
add_rxn     6 local G nbr 0.00 local G G nbr                # AR+ Te proliferation

add_rxn     7 local I nbr 0.3817 local I nbr                # Tp recruitment
add_rxn     8 local I nbr 0.3817 local I nbr                # Tm recruitment
add_rxn     9 local I nbr 0 local I nbr                     # Te recruitment
add_rxn     10 local I nbr 0.0424 local I nbr               # AR+ Tp recruitment
add_rxn     11 local I nbr 0.0424 local I nbr               # AR+ Tm recruitment
add_rxn     12 local I nbr 0 local I nbr                    # AR+ Te recruitment

add_rxn	    13 local B nbr 0.2375 local nbr B               # Tp motility
add_rxn	    14 local C nbr 0.2375 local nbr C               # Tm motility
add_rxn	    15 local D nbr 0.2375 local nbr D               # Te motility
add_rxn	    16 local E nbr 0.2375 local nbr E               # AR+ Tp motility
add_rxn	    17 local F nbr 0.2375 local nbr F               # AR+ Tm motility
add_rxn	    18 local G nbr 0.2375 local nbr G               # AR+ Te motility

add_rxn     19 local B nbr 0.00694 local C nbr              # Tp differentiation to Tm, 1/d
add_rxn     20 local E nbr 0.00694 local F nbr              # AR+ Tp differentiation to AR+ Tm, 1/d

add_rxn     21 local A C nbr 0.0106 local A D nbr           # Tm cancer exhaustion local 1/16hr
add_rxn     22 local A nbr C 0.0106 local A nbr D           # Tm cancer exhaustion nbr
add_rxn     23 local A F nbr 0.0106 local A G nbr           # AR+ Tm cancer exhaustion local
add_rxn     24 local A nbr F 0.0106 local A nbr G           # AR+ Tm cancer exhaustion nbr

add_rxn	    25 local D nbr 0.00694 local nbr                # Te death, 1/d
add_rxn	    26 local G nbr 0.00694 local nbr                # AR+ Te death, 1/d

add_rxn	    27 local C A nbr 0.06 local C nbr               # Cancer lysis by Tm local
add_rxn	    28 local C nbr A 0.06 local C nbr               # Cancer lysis by Tm nbr
add_rxn	    29 local D A nbr 0.06 local D nbr               # Cancer lysis by Te local
add_rxn     30 local D nbr A 0.06 local D nbr               # Cancer lysis by Te nbr
add_rxn	    31 local F A nbr 0.06 local F nbr               # Cancer lysis by AR+ Tm local
add_rxn	    32 local F nbr A 0.06 local F nbr               # Cancer lysis by AR+ Tm nbr
add_rxn	    33 local G A nbr 0.06 local G nbr               # Cancer lysis by AR+ Te local
add_rxn     34 local G nbr A 0.06 local G nbr               # Cancer lysis by AR+ Te nbr

add_rxn     35 local B nbr 0.00694 local nbr                # Tp death or outflow, 1/d
add_rxn     36 local C nbr 0.00694 local nbr                # Tm death, 1/d
add_rxn     37 local E nbr 0.00694 local nbr                # AR+ Tp death, 1/d
add_rxn     38 local F nbr 0.00694 local nbr                # AR+ Tm death, 1/d

add_rxn     39 local L nbr 0.00 local L nbr                 # Cells floating in?

diag_style propensity
diag_style array i1 sum i2 sum i3 sum i4 sum i5 sum i6 sum i7 sum i8 sum d1 sum i9 sum i10 sum i11 sum i12 sum

stats           1.0
#dump            1 sites 1.0 dump.2D_model.* id i1 i2 i3 i4 i5 i6 i7 i8 d1 i9 i10 i11 i12
#dump_modify	1 vtk 10 10 10 0 100
#dump_modify	1 sort id
run             1008 # 1 week (between time steps in data), 2016 for 2 weeks
