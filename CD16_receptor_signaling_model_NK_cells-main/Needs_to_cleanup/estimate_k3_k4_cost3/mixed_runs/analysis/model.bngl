begin molecule types
  A(State~UZAP~PZAP~SHP~uSYK~pSYK)
  Gamma(receptor,ITAM1~U~PP,ITAM2~U~PP)
  Hetero(receptor,ITAM1~U~PP,ITAM2~U~PP,ITAM3~U~PP,ITAM4~U~PP)
  LCK()
  Zeta(receptor,ITAM1~U~PP,ITAM2~U~PP,ITAM3~U~PP,ITAM4~U~PP,ITAM5~U~PP,ITAM6~U~PP)
  ligand(receptor)
end molecule types

begin species
  A(State~UZAP) ZAP0
  Zeta(ITAM1~U,ITAM2~U,ITAM3~U,ITAM4~U,ITAM5~U,ITAM6~U,receptor) _InitialConc1
  LCK() LCK0
  ligand(receptor) L0
  A(State~SHP) S0
  A(State~uSYK) SYK0
  Gamma(ITAM1~U,ITAM2~U,receptor) _InitialConc2
  Hetero(ITAM1~U,ITAM2~U,ITAM3~U,ITAM4~U,receptor) _InitialConc3
end species

begin observables
  Molecules Adaptor_bound ligand(receptor!+)
  Molecules Adaptor_free Zeta(receptor),Hetero(receptor),Gamma(receptor)
  Molecules bound_SHP1 A(State~SHP!+)
  Molecules bound_ZAP_SYK A(State~PZAP!+),A(State~UZAP!+),A(State~uSYK!+),A(State~pSYK!+)
  Molecules bound_pSYK_uSYK Zeta(receptor!+,ITAM1!1,ITAM2!2,ITAM3!3,ITAM4!4,ITAM5!5,ITAM6!6).A(State~uSYK!1).A(State~uSYK!2).A(State~uSYK!3).A(State~uSYK!4).A(State~uSYK!5).A(State~uSYK!6),Zeta(receptor!+,ITAM1!1,ITAM2!2,ITAM3!3,ITAM4!4,ITAM5!5,ITAM6!6).A(State~pSYK!1).A(State~pSYK!2).A(State~pSYK!3).A(State~pSYK!4).A(State~pSYK!5).A(State~pSYK!6),Hetero(receptor!+,ITAM1!1,ITAM2!2,ITAM3!3,ITAM4!4).A(State~uSYK!1).A(State~uSYK!2).A(State~uSYK!3).A(State~uSYK!4),Hetero(receptor!+,ITAM1!1,ITAM2!2,ITAM3!3,ITAM4!4).A(State~pSYK!1).A(State~pSYK!2).A(State~pSYK!3).A(State~pSYK!4),Gamma(receptor!+,ITAM1!1,ITAM2!2).A(State~pSYK!1).A(State~pSYK!2),Gamma(receptor!+,ITAM1!1,ITAM2!2).A(State~uSYK!1).A(State~uSYK!2)
  Molecules PZAP_bound A(State~PZAP!+)
  Molecules PZAP_free A(State~PZAP)
  Molecules PZAP_total A(State~PZAP!?)
  Molecules ZAP_bound A(State~PZAP!+),A(State~UZAP!+)
  Molecules ZAP_free A(State~PZAP),A(State~UZAP)
  Molecules pSYK_bound A(State~pSYK!+)
  Molecules pSYK_free A(State~pSYK)
  Molecules pSYK_total A(State~pSYK!?)
  Molecules SYK_bound A(State~uSYK!+),A(State~pSYK!+)
  Molecules SYK_free A(State~pSYK),A(State~uSYK)
end observables

begin reaction rules
  r2_ligand_binding: ligand(receptor) + Zeta(receptor,ITAM1~U,ITAM2~U,ITAM3~U,ITAM4~U,ITAM5~U,ITAM6~U) <-> Zeta(receptor!1,ITAM1~U,ITAM2~U,ITAM3~U,ITAM4~U,ITAM5~U,ITAM6~U).ligand(receptor!1) kon,koff 
