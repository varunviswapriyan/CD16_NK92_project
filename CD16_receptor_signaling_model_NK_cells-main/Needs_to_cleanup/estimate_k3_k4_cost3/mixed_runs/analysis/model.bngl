  r95_KP: Zeta(receptor!1).ligand(receptor!1) -> ligand(receptor) + Zeta(receptor) KPR 
  r96_KP_adaptor_dephosph_pZAP_ITAM1: Zeta(receptor,ITAM1!1).A(State~PZAP!1) -> Zeta(receptor,ITAM1!1).A(State~UZAP!1) _rateLaw1 
  r97_KP_adaptor_dephosph_pZAP_ITAM2: Zeta(receptor,ITAM2!1).A(State~PZAP!1) -> Zeta(receptor,ITAM2!1).A(State~UZAP!1) _rateLaw2 
  r108_LRZ1_breaking_ITAM1: Zeta(receptor,ITAM1!1).A(State!1) -> A(State) + Zeta(receptor,ITAM1) kh 
  r109_LRZ1_breaking_ITAM2: Zeta(receptor,ITAM2!1).A(State!1) -> A(State) + Zeta(receptor,ITAM2) kh 
