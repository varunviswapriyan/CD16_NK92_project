begin model


begin parameters
Ve 0.05 #Extracellular volume
Vc 25.0 #Cytosolic volume
A 25.0 #membrane area
f 602.3 #conversion constant muM to molecules per \mu m^{-3}
kon ((0.000017)/Ve)  #ligand-receptor binding rate (um^3 s^{-1} molecule^{-1}) #updated # Do not change
koff 0.01 #ligand-receptor unbinding rate (sec^{-1})
Kab 0.002 #adaptor binding (um^2 s^{-1} molecule^{-1}) #Assumption
KB Kab/A #adaptor binding (um^2 s^{-1} molecule^{-1}) 
KU 0.01 #adaptor unbinding (sec^{-1}) #Assumption
kp 0.015/A #ITAM phosphorylation (um^2 s^{-1} molecule^{-1})
kd 0.001 #ITAM dephosphorylation (sec^{-1})
KZB 0.0083 #ZAP/SYK binding rate
kzb  (KZB)/Vc #ZAP binding (um^3 s^{-1} molecule^{-1}) #changed
kzu  0.125	#ZAP unbinding (sec^{-1}) #changed
kzp (4.98E-5)/Vc #ZAP phosphorylation rate (um^3 s^{-1} molecule^{-1}) by LCK
kzd (5.64E-5)/Vc #free or bound ZAP dephosphorylation rate (um^3 s^{-1} molecule^{-1}) 

ksbPP  (4.15E-4)/Vc  #PP-SHP binding (um^3 s^{-1} molecule^{-1}) #changed
ksuPP  1.7   #PP-SHP unbinding (sec^{-1}) #changed
ksbU  (4.15E-4)/Vc  #U-SHP binding (um^3 s^{-1} molecule^{-1}) #have to appoximate #changed on 5th April 2023
ksuU  1.7   #ZAP unbinding (sec^{-1}) #changed on 5th April 2023

kdl 0.001 #CBL degrades ZAP/SYK 
KPR 0.01 #kinetic proof reading step (sec^{-1})
kh 10000 #high dissociation rate (sec^{-1})
#*********************************************************SYK**************************************************************************
# Need to estimate KSB : SYK binding rate
KSB 0.0083
ksb  (KSB)/Vc #SYK binding (um^3 s^{-1} molecule^{-1}) 
ksu  0.125	#SYK unbinding (sec^{-1}) #changed
ksbss ksb*0.1
KSA0 0.0026 #estimated in previous paper
KST0 0.0022 #estimated in previous paper
ksa KSA0 #Basally active ITAM bound SYK auto-phosphorylates and become catalytically active SYK (sec^{-1}) #changed
kst  (KST0)/Vc #Catalytically active ITAM bound SYK phosphorylates ITAM bound basally active Syk (um^3 s^{-1} molecule^{-1}) 

ksi 1.21 #ITAM bound Catalytically active SYK auto-phosphorylates the ITAM 
ksil  (0.014)/Vc #ITAM bound basally active SYK trans-phosphorylates the ITAM with low rate (um^3 s^{-1} molecule^{-1}) 
ksih (0.025)/Vc #ITAM bound catalytically active SYK trans-phosphorylates the ITAM with high rate (um^3 s^{-1} molecule^{-1}) 
ksd (5.64E-5)/Vc #free or bound SYK de-phosphorylation rate  by SHP1(um^3 s^{-1} molecule^{-1}) #Assumption (um^3 s^{-1} molecule^{-1}) 
kfd 0.01 #free pZAP/pSYK dephosphorylation

#total number of molecules in the box
#total number of molecules in the box
L0     60*A     # Initial ligand number 
R0 		80*A        #Initial receptor number
adaptor0 80
A0		adaptor0*A       #initial adaptor number #changed 26th February
LCK0	390*A      #initial Lck number
Z0		1131    #estimated in previous paper
ZAP0    Z0*Vc     #initial ZAP70 number  # need to ESTIMATE
SS0     754    #estimated in previous paper
SYK0	SS0*Vc		#initial SYK number		#need to ESTIMATE
S0 	180*Vc  #initial concentration of SHP1
end parameters

begin molecule types
LCK()
Ligand(Site)
Zeta(receptor,ITAM1~U~PP,ITAM2~U~PP,ITAM3~U~PP,ITAM4~U~PP,ITAM5~U~PP,ITAM6~U~PP)
A(State~UZAP~PZAP~SHP~uSYK~pSYK)
CD16(lig,receptor)
CBL()
end molecule types

begin seed species
1  A(State~UZAP) ZAP0
2  Zeta(receptor,ITAM1~U,ITAM2~U,ITAM3~U,ITAM4~U,ITAM5~U,ITAM6~U) A0
3  LCK() LCK0
4  Ligand(Site) L0
5  CD16(lig,receptor) R0
6  A(State~SHP) S0
7  A(State~uSYK) SYK0
end seed species

begin observables
Molecules PZAP_total  A(State~PZAP!?)
Molecules pSYK_total  A(State~pSYK!?)
Molecules pSYK_bound  A(State~pSYK!+)
Molecules pSYK_free  A(State~pSYK)
Molecules PZAP_bound  A(State~PZAP!+)
Molecules PZAP_free  A(State~PZAP)
Molecules bound_SHP1  A(State~SHP!+)
Molecules zeta_bound   Zeta(receptor!+)
Molecules zeta_free   Zeta(receptor)
Molecules CD16_bound  CD16(lig!+,receptor!+)
end observables

begin functions
end functions

begin reaction rules
r1_ligand_binding:	 Ligand(Site) +  CD16(lig,receptor) <->  CD16(lig!1,receptor).Ligand(Site!1)		kon, koff
r2_Adaptor_binding:	 CD16(lig!1,receptor).Ligand(Site!1) +  Zeta(receptor,ITAM1~U,ITAM2~U,ITAM3~U,ITAM4~U,ITAM5~U,ITAM6~U) <->  Zeta(receptor!1,ITAM1~U,ITAM2~U,ITAM3~U,ITAM4~U,ITAM5~U,ITAM6~U).CD16(lig!2,receptor!1).Ligand(Site!2)		KB, KU
r3_ITAM1_phosphorylation:	 LCK() +  Zeta(receptor!+,ITAM1~U) ->  LCK() +  Zeta(receptor!+,ITAM1~PP)		kp
r4_ITAM2_phosphorylation:	 LCK() +  Zeta(receptor!+,ITAM2~U) ->  LCK() +  Zeta(receptor!+,ITAM2~PP)		kp
r9_ITAM1_dephosphorylation:	 Zeta(receptor!+,ITAM1~PP) ->  Zeta(receptor!+,ITAM1~U)		kd
r10_ITAM2_dephosphorylation:	 Zeta(receptor!+,ITAM2~PP) ->  Zeta(receptor!+,ITAM2~U)		kd
r15_PZAP_binding_ITAM1:	 A(State~PZAP) +  Zeta(receptor!+,ITAM1~PP) <->  Zeta(receptor!+,ITAM1~PP!1).A(State~PZAP!1)		kzb, kzu
r17_PZAP_binding_ITAM3:	 A(State~PZAP) +  Zeta(receptor!+,ITAM3~PP) <->  Zeta(receptor!+,ITAM3~PP!1).A(State~PZAP!1)		kzb, kzu
r21_UZAP_binding_ITAM1:	 A(State~UZAP) +  Zeta(receptor!+,ITAM1~PP) <->  Zeta(receptor!+,ITAM1~PP!1).A(State~UZAP!1)		kzb, kzu
r22_UZAP_binding_ITAM2:	 A(State~UZAP) +  Zeta(receptor!+,ITAM2~PP) <->  Zeta(receptor!+,ITAM2~PP!1).A(State~UZAP!1)		kzb, kzu
r86_uZAP_phosphorylation_by_LCK:	 A(State~UZAP!+) +  LCK() ->  A(State~PZAP!+) +  LCK()		kzp
r84_bound_pZAP_dephosphorylation_by_SHP:	 A(State~SHP!+)%1 +  A(State~PZAP!+)%2 ->  A(State~SHP!+)%1 +  A(State~UZAP!+)%2		kzd
r93_free_ZAP_dephosphorylation_SHP:	 A(State~SHP!+)%1 +  A(State~PZAP)%2 ->  A(State~SHP!+)%1 +  A(State~UZAP)%2		kzd
r57_SHP_binding_ITAM1_PP:	 A(State~SHP) +  Zeta(receptor!+,ITAM1~PP) <->  Zeta(receptor!+,ITAM1~PP!1).A(State~SHP!1)		ksbPP, ksuPP
r58_SHP_binding_ITAM2_PP:	 A(State~SHP) +  Zeta(receptor!+,ITAM2~PP) <->  Zeta(receptor!+,ITAM2~PP!1).A(State~SHP!1)		ksbPP, ksuPP
r51_SHP_binding_ITAM1_U:	 A(State~SHP) +  Zeta(receptor!+,ITAM1~U) <->  Zeta(receptor!+,ITAM1~U!1).A(State~SHP!1)		ksbU, ksuU
r52_SHP_binding_ITAM2_U:	 A(State~SHP) +  Zeta(receptor!+,ITAM2~U) <->  Zeta(receptor!+,ITAM2~U!1).A(State~SHP!1)		ksbU, ksuU
r95_KP:	 Zeta(receptor!3).CD16(lig!2,receptor!3).Ligand(Site!2) ->  Ligand(Site) +  CD16(lig,receptor) +  Zeta(receptor)		KPR
r120_KP_new_JJ:	 Zeta(receptor!3).CD16(lig!2,receptor!3).Ligand(Site!2) ->  Ligand(Site!1).CD16(lig!1,receptor) +  Zeta(receptor)		KU
r96_KP_adaptor_dephosph_pZAP_ITAM1:	 Zeta(receptor,ITAM1!1).A(State~PZAP!1) ->  Zeta(receptor,ITAM1!1).A(State~UZAP!1)		kh
r97_KP_adaptor_dephosph_pZAP_ITAM2:	 Zeta(receptor,ITAM2!1).A(State~PZAP!1) ->  Zeta(receptor,ITAM2!1).A(State~UZAP!1)		kh
r108_LRZ1_breaking_ITAM1:	 Zeta(receptor,ITAM1!1).A(State!1) ->  A(State) +  Zeta(receptor,ITAM1)		kh
r109_LRZ1_breaking_ITAM2:	 Zeta(receptor,ITAM2!3).A(State!3) ->  A(State) +  Zeta(receptor,ITAM2)		kh
r114_zeta_convert1:	 Zeta(receptor,ITAM1~PP) ->  Zeta(receptor,ITAM1~U)		kh
r115_zeta_convert2:	 Zeta(receptor,ITAM2~PP) ->  Zeta(receptor,ITAM2~U)		kh
r27_uSYK_binding_ITAM1:	 A(State~uSYK) +  Zeta(receptor!+,ITAM1~U) <->  Zeta(receptor!+,ITAM1~U!1).A(State~uSYK!1)		ksbss, ksu
r28_uSYK_binding_ITAM2:	 A(State~uSYK) +  Zeta(receptor!+,ITAM2~U) <->  Zeta(receptor!+,ITAM2~U!1).A(State~uSYK!1)		ksbss, ksu
r33_uSYK_binding_ITAM1PP:	 A(State~uSYK) +  Zeta(receptor!+,ITAM1~PP) <->  Zeta(receptor!+,ITAM1~PP!1).A(State~uSYK!1)		ksb, ksu
r34_uSYK_binding_ITAM2PP:	 A(State~uSYK) +  Zeta(receptor!+,ITAM2~PP) <->  Zeta(receptor!+,ITAM2~PP!1).A(State~uSYK!1)		ksb, ksu
r39_PSYK_binding_ITAM1:	 A(State~pSYK) +  Zeta(receptor!+,ITAM1~U) <->  Zeta(receptor!+,ITAM1~U!1).A(State~pSYK!1)		ksbss, ksu
r40_PSYK_binding_ITAM2:	 A(State~pSYK) +  Zeta(receptor!+,ITAM2~U) <->  Zeta(receptor!+,ITAM2~U!1).A(State~pSYK!1)		ksbss, ksu
r45_PSYK_binding_ITAM1PP:	 A(State~pSYK) +  Zeta(receptor!+,ITAM1~PP) <->  Zeta(receptor!+,ITAM1~PP!1).A(State~pSYK!1)		ksb, ksu
r46_PSYK_binding_ITAM2PP:	 A(State~pSYK) +  Zeta(receptor!+,ITAM2~PP) <->  Zeta(receptor!+,ITAM2~PP!1).A(State~pSYK!1)		ksb, ksu
r83_ITAM_bound_SYK_phosphorylation_by_LCK:	 A(State~uSYK!+) +  LCK() ->  A(State~pSYK!+) +  LCK()		kzp
r63_uSYK_autophosphorylation:	 A(State~uSYK!+) ->  A(State~pSYK!+)		ksa
r64_pSYK_transphosphorylation_uSYK:	 A(State~uSYK!+)%3 +  A(State~pSYK!+)%4 ->  A(State~pSYK!+)%3 +  A(State~pSYK!+)%4		kst
r65_pSYK_phosphorylating_self_ITAM1:	 Zeta(receptor!+,ITAM1~U!1).A(State~pSYK!1) ->  Zeta(receptor!+,ITAM1~PP!1).A(State~pSYK!1)		ksi
r67_pSYK_phosphorylating_self_ITAM3:	 Zeta(receptor!+,ITAM3~U!1).A(State~pSYK!1) ->  Zeta(receptor!+,ITAM3~PP!1).A(State~pSYK!1)		ksi
r71_pSYK_transphosphorylating_other_ITAM1:	 A(State~pSYK!+) +  Zeta(receptor!+,ITAM1~U!?) ->  A(State~pSYK!+) +  Zeta(receptor!+,ITAM1~PP!?)		ksih
r72_pSYK_transphosphorylating_other_ITAM2:	 A(State~pSYK!+) +  Zeta(receptor!+,ITAM2~U!?) ->  A(State~pSYK!+) +  Zeta(receptor!+,ITAM2~PP!?)		ksih
r94_free_SYK_dephosphorylation_SHP:	 A(State~SHP!+)%1 +  A(State~pSYK)%2 ->  A(State~SHP!+)%1 +  A(State~uSYK)%2		ksd
r85_bound_pSYK_dephosphorylation_by_SHP:	 A(State~SHP!+)%1 +  A(State~pSYK!+)%2 ->  A(State~SHP!+)%1 +  A(State~uSYK!+)%2		ksd
r102_KP_adaptor_dephosph_pSYK_ITAM1:	 Zeta(receptor,ITAM1!1).A(State~pSYK!1) ->  Zeta(receptor,ITAM1!1).A(State~uSYK!1)		kh
r103_KP_adaptor_dephosph_pSYK_ITAM2:	 Zeta(receptor,ITAM2!1).A(State~pSYK!1) ->  Zeta(receptor,ITAM2!1).A(State~uSYK!1)		kh
r89_bound_CBL_degrade_uZAP:	 A(State~UZAP!+) ->  Ligand(Site)		kdl
r87_Free_pZAP_dephosph:	 A(State~PZAP) ->  A(State~UZAP)		kfd
r88_Free_pSYK_dephosph:	 A(State~pSYK) ->  A(State~uSYK)		kfd
r90_bound_CBL_degrade_pZAP:	 A(State~PZAP!+) ->  Ligand(Site)		kdl
r91_bound_CBL_degrade_uSYK:	 A(State~uSYK!+) ->  Ligand(Site)		kdl
r92_bound_CBL_degrade_pSYK:	 A(State~pSYK!+) ->  Ligand(Site)		kdl
r5_ITAM3_phosphorylation:	 LCK() +  Zeta(receptor!+,ITAM3~U) ->  LCK() +  Zeta(receptor!+,ITAM3~PP)		kp
